PORT=4000

# Required in production. The server refuses to start if this is left at the
# default, because a known secret means anyone can mint an administrator token.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

ADMIN_USERNAME=admin

# Must be changed. The server refuses to start in production while this is the
# documented default, since that value is public in this repository.
ADMIN_PASSWORD=MABDC@2026

# Comma-separated list of origins the browser may call this API from, e.g.
# https://election.example.org. Enforced only when NODE_ENV=production.
# Requests with no Origin header (same-origin navigation, curl) are always allowed.
ALLOWED_ORIGINS=

# Login throttling. Defaults are loose on purpose — this is a supervised
# single-day election, and locking out a learner or a teacher mid-vote is worse
# than the brute-force attempt it would prevent. Only FAILED attempts count, and
# one successful sign-in clears the counter.
#   RATE_LIMITS_ENABLED=false   turns throttling off completely for election day
#   VOTER_LOGIN_MAX             failed attempts per Voter ID per 10 min (default 40)
#   ADMIN_LOGIN_MAX             failed attempts per IP per 15 min (default 60)
RATE_LIMITS_ENABLED=true
VOTER_LOGIN_MAX=40
ADMIN_LOGIN_MAX=60
